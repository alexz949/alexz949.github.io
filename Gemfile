source 'https://rubygems.org'

gem 'jekyll'

# Jekyll plugins used by the site
group :jekyll_plugins do
    gem 'jekyll-3rd-party-libraries'
    gem 'jekyll-archives-v2'    # blog year/tag/category pages
    gem 'jekyll-cache-bust'
    gem 'jekyll-feed'
    gem 'jekyll-link-attributes'
    gem 'jekyll-minifier'
    gem 'jekyll-paginate-v2'
    gem 'jekyll-regex-replace'
    gem 'jekyll-scholar'        # papers from _bibliography/papers.bib
    gem 'jekyll-sitemap'
    gem 'jekyll-socials'
    gem 'jekyll-toc'
end

group :other_plugins do
    gem 'css_parser'
    gem 'observer'       # used by jekyll-scholar
end

# al-folio theme runtime and the features this site uses
group :al_folio_plugins do
    gem 'al_folio_core', '= 1.0.15'
    gem 'al_icons', '= 1.0.0'
    gem 'al_img_tools', '= 1.0.3'   # image zoom
    gem 'al_search', '= 1.0.3'      # ctrl-k search
    gem 'al_math', '= 1.0.2'        # MathJax in blog posts
    gem 'al_citations', '= 1.0.1'   # citation tags used by the paper list template
end
